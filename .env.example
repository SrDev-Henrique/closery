# Copie para .env.local e preencha. Nunca commite o .env.local.
# Local usa a branch de DESENVOLVIMENTO do Neon; produção fica só na Vercel.
# Neon → branch de dev → Connect: copie as duas connection strings.

# Conexão direta, sem pooler (usada pelo drizzle-kit nas migrações)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Conexão com pooler — host com "-pooler" (runtime da aplicação)
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Também funciona a convenção do `neon env pull`: DATABASE_URL (pooler) +
# DATABASE_URL_UNPOOLED (direta). Ver src/db/databaseUrl.ts.

# --- Autenticação (Better Auth) ---
# Segredo que assina sessões e tokens. Mínimo 32 caracteres. Gere com:
#   openssl rand -base64 32
# Em produção e em cada Preview da Vercel, use um valor próprio.
BETTER_AUTH_SECRET=""

# URL pública do app, sem barra final. Passkeys e callbacks de login social
# dependem dela. Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Login com Google (opcional). Preencha os DOIS ou deixe os dois vazios.
# Console do Google Cloud → Credenciais → ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Login com Facebook (opcional). Preencha os DOIS ou deixe os dois vazios.
# Meta for Developers → app → Login do Facebook.
# URI de redirecionamento: <BETTER_AUTH_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
